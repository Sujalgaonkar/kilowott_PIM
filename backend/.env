# ==============================================================================
# PIM Backend Environment Configuration
# ==============================================================================

# 1. WooCommerce Configuration
# By default, FORCE_MOCK_WC=true enables Mock mode (no credentials required).
# To connect a real WooCommerce store, set your credentials below and FORCE_MOCK_WC=false.
FORCE_MOCK_WC=true
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# 2. AI / LLM Configuration (Optional)
# If blank, the system uses the built-in grounded copy engine without external API calls.
# To enable real Gemini or OpenAI generation, provide your key below:
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. Server Configuration
HOST=127.0.0.1
PORT=8000
